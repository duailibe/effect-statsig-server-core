{
  "name": "effect-statsig-server-core",
  "version": "0.1.0",
  "description": "Statsig feature gates and experiments for Effect, on Statsig's native server core. Unofficial.",
  "keywords": [
    "effect",
    "experiments",
    "feature-flags",
    "feature-gates",
    "statsig"
  ],
  "homepage": "https://github.com/duailibe/effect-statsig-server-core#readme",
  "bugs": {
    "url": "https://github.com/duailibe/effect-statsig-server-core/issues"
  },
  "license": "MIT",
  "author": "Lucas Duailibe <lucasds@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duailibe/effect-statsig-server-core.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepublishOnly": "pnpm check && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.3",
    "@effect/vitest": "^4.0.0",
    "@types/node": "^24",
    "effect": "^4.0.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "tsdown": "^0.23.0",
    "typescript": "^5.9",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "effect": "^4.0.0"
  },
  "optionalDependencies": {
    "@statsig/statsig-node-core-darwin-arm64": "0.23.1",
    "@statsig/statsig-node-core-darwin-x64": "0.23.1",
    "@statsig/statsig-node-core-linux-arm64-gnu": "0.23.1",
    "@statsig/statsig-node-core-linux-arm64-musl": "0.23.1",
    "@statsig/statsig-node-core-linux-x64-gnu": "0.23.1",
    "@statsig/statsig-node-core-linux-x64-musl": "0.23.1",
    "@statsig/statsig-node-core-win32-arm64-msvc": "0.23.1",
    "@statsig/statsig-node-core-win32-ia32-msvc": "0.23.1",
    "@statsig/statsig-node-core-win32-x64-msvc": "0.23.1"
  },
  "packageManager": "pnpm@10.33.0"
}
